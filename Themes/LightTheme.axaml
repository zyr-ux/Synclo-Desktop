<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Accent">#363b3e</Color>
    <Color x:Key="PrimaryBackground">#dedede</Color>
    <Color x:Key="SidebarBackground">#b5b8b8</Color>
    <Color x:Key="SidebarButtonBackground">#8a8a8a</Color>
    <Color x:Key="ForegroundD">#dedede</Color>
    <Color x:Key="ForegroundL">#363c40</Color>
    <Color x:Key="Yellow">#ebc16e</Color>

</ResourceDictionary>