<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Accent">#363b3e</Color>
    <Color x:Key="PrimaryBackground">#f3f3f3</Color>
    <Color x:Key="SecondaryBackground">#f9f9f9</Color>
    <Color x:Key="ForegroundD">#dedede</Color>
    <Color x:Key="Foreground">Black</Color>
    <SolidColorBrush x:Key="StatusOnline" Color="#2D991F" />
    <SolidColorBrush x:Key="StatusOffline" Color="#B00020" />
    <SolidColorBrush x:Key="StatusNoInternet" Color="#E65100" />
    <SolidColorBrush x:Key="Border" 
                     Color="{DynamicResource SystemBaseHighColor}" 
                     Opacity="0.06" />
    <SolidColorBrush x:Key="Gray" 
                     Color="{DynamicResource SystemBaseHighColor}" 
                     Opacity="0.05" />
    <SolidColorBrush x:Key="MicaWindowBackground" Color="#F3F3F3" Opacity="0.70" />
    <SolidColorBrush x:Key="MicaContentBackground" Color="#F9F9F9" Opacity="0.85" />

</ResourceDictionary>