<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Accent">#c9c4c1</Color>
    <Color x:Key="PrimaryBackground">#202020</Color>
    <Color x:Key="SecondaryBackground">#272727</Color>
    <Color x:Key="ForegroundD">#212121</Color>
    <Color x:Key="Foreground">White</Color>
    <SolidColorBrush x:Key="StatusOnline" Color="#00FF00" />
    <SolidColorBrush x:Key="StatusOffline" Color="#FF5252" />
    <SolidColorBrush x:Key="StatusNoInternet" Color="#FFB74D" />
    <SolidColorBrush x:Key="Border" 
                     Color="{DynamicResource SystemBaseHighColor}" 
                     Opacity="0.06" />
    <SolidColorBrush x:Key="Gray" 
                     Color="{DynamicResource SystemBaseHighColor}" 
                     Opacity="0.05" />
    <SolidColorBrush x:Key="MicaWindowBackground" Color="Transparent" />
    <SolidColorBrush x:Key="MicaContentBackground" Color="White" Opacity="0.06" />

</ResourceDictionary>