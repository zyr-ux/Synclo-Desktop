<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Synclo/Themes/LightTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--This fixes the avalonia title bar buttons hover and pressed background. fix found from this GitHub issues page https://github.com/AvaloniaUI/Avalonia/issues/14596 -->
            <SolidColorBrush
                x:Key="CaptionButtonBackground"
                Color="{DynamicResource SystemBaseLowColor}" />
            <SolidColorBrush
                x:Key="CaptionButtonBorderBrush"
                Color="{DynamicResource SystemBaseMediumLowColor}" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Synclo/Themes/DarkTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush
                x:Key="CaptionButtonBackground"
                Color="{DynamicResource SystemBaseLowColor}" />
            <SolidColorBrush
                x:Key="CaptionButtonBorderBrush"
                Color="{DynamicResource SystemBaseMediumLowColor}" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- Static / Theme-Independent Colors & Brushes -->
    <SolidColorBrush x:Key="BrandAvalonia" Color="#007DF9" />
    <SolidColorBrush x:Key="Hyperlink" Color="#3B82F6" />
    <SolidColorBrush x:Key="HyperlinkPointerOver" Color="#60A5FA" />
    <SolidColorBrush x:Key="DialogOverlay" Color="#000000" />
    <SolidColorBrush x:Key="IconButtonPointerOver" Color="#1A000000" />
    <SolidColorBrush x:Key="IconButtonPressed" Color="#33000000" />
    <SolidColorBrush x:Key="TextMuted" Color="#666666" />
    <SolidColorBrush x:Key="TextError" Color="#FF5555" />
    <SolidColorBrush x:Key="TextWarning" Color="OrangeRed" />
    <SolidColorBrush x:Key="Danger" Color="Red" />
    <SolidColorBrush x:Key="DangerForeground" Color="White" />

</ResourceDictionary>