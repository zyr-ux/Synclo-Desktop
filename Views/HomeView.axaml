<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:Synclo.ViewModels"
             xmlns:models="clr-namespace:Synclo.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Synclo.Views.HomeView"
             x:DataType="vm:HomeViewModel"
             Background="{DynamicResource PrimaryBackground}">

    <UserControl.DataContext>
        <vm:HomeViewModel />
    </UserControl.DataContext>

    <Grid RowDefinitions="Auto, *, Auto" Margin="30">

        <!-- title -->
        <TextBlock Grid.Row="0"
                   Text="History"
                   FontSize="36"
                   FontFamily="{DynamicResource Inconsolata-Bold}"
                   Foreground="#FFCC66" />

        <!-- refresh button -->
        <Button Classes="icon-button"
                HorizontalAlignment="Right"
                IsEnabled="{Binding !IsLoading}"
                Command="{Binding RefreshClipboardHistoryCommand}">
            <materialIcons:MaterialIcon
                Kind="Refresh"
                Width="30"
                Height="30" />
        </Button>

        <!--history list-->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding HistoryEntries}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="20" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="models:ClipboardEntry">
                    <Button Background="Transparent"
                            BorderBrush="Transparent"
                            Padding="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).ItemClickedCommand}"
                            CommandParameter="{Binding}">

                        <StackPanel>
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="{Binding plaintext}"
                                           VerticalAlignment="Center"
                                           Foreground="#e0e0e0"
                                           FontFamily="{DynamicResource Inconsolata-Bold}"
                                           FontSize="20" />

                                <TextBlock Grid.Column="1"
                                           Text="{Binding timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                           VerticalAlignment="Center"
                                           Foreground="#bbbbbb"
                                           FontSize="18" />
                            </Grid>

                            <Border Height="1"
                                    Background="#444"
                                    Margin="0,10,0,0" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </Grid>
</UserControl>