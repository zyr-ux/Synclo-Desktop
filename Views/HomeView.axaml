<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:Synclo.ViewModels"
             xmlns:models="clr-namespace:Synclo.Models"
             xmlns:behaviors="clr-namespace:Synclo.Behaviors"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="Synclo.Views.HomeView"
             x:DataType="vm:HomeViewModel">
    
    <Grid RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0"
                    Margin="30,30,30,0"
                    Orientation="Vertical">

            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="History"
                               FontSize="36"
                               FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold"
                               Foreground="{DynamicResource Foreground}" />

                    <Button Classes="icon-button"
                            Margin="20 0 0 0"
                            VerticalAlignment="Center"
                            Command="{Binding RefreshClipboardHistoryCommand}"
                            ToolTip.Tip="Refresh Clipboard Contents">
                        <materialIcons:MaterialIcon Kind="Refresh"
                                                    Width="26"
                                                    Height="26" />
                    </Button>
                </StackPanel>
                
                <Button Grid.Column="1"
                        Classes="icon-button"
                        VerticalAlignment="Center"
                        Margin="0 0 15 0"
                        Command="{Binding ClearClipboardHistoryCommand}"
                        ToolTip.Tip="Clear Clipboard History">
                    <materialIcons:MaterialIcon Kind="NotificationClearAll"
                                                Width="26"
                                                Height="26" />
                </Button>
            </Grid>

            <Border Height="1"
                    Background="{DynamicResource Accent}"
                    Opacity="0.5"
                    Margin="-5 14 -5 0" />
        </StackPanel>

        <TextBlock Grid.Row="0"
                   Grid.RowSpan="2"
                   Text="{Binding HomeStatusMessage}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center"
                   FontSize="20"
                   FontFamily="{DynamicResource AppFontFamily}"
                   Foreground="{DynamicResource Foreground}"
                   IsVisible="{Binding HomeStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   IsHitTestVisible="False" />

        <!-- Clipboard Items ListBox -->
        <ListBox Grid.Row="1"
                 Classes="HistoryList"
                 ItemsSource="{Binding HistoryEntries}">

            <Interaction.Behaviors>
                <!-- Infinite Scroll Behavior adapted for ListBox internal ScrollViewer -->
                <behaviors:ScrollViewerInfiniteScrollBehavior Command="{Binding LoadMoreCommand}" />
                <!-- Smooth Scrolling Behavior wrapper -->
                <behaviors:ListBoxSmoothScrollBehavior />
            </Interaction.Behaviors>

            <ListBox.ItemTemplate>
                <DataTemplate DataType="models:HistoryItemModel">
                    <Border Classes="HistoryItem"
                            Classes.clearing="{Binding IsBeingCleared}"
                            ClipToBounds="True"
                            PointerPressed="OnHistoryItemPointerPressed">
                        <Border.ContextMenu>
                            <ContextMenu Opening="OnContextMenuOpening" Closing="OnContextMenuClosing">
                                <MenuItem Header="Copy"
                                          Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).ItemClickedCommand}"
                                          CommandParameter="{Binding}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="ContentCopy" Width="16" Height="16" Foreground="{DynamicResource Foreground}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{Binding IsPinned, Converter={StaticResource PinStateToMenuHeaderConverter}}"
                                          Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).TogglePinCommand}"
                                          CommandParameter="{Binding}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="{Binding IsPinned, Converter={StaticResource PinStateToIconConverter}}" Width="16" Height="16" Foreground="{DynamicResource Foreground}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Delete"
                                          Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).DeleteItemClickedCommand}"
                                          CommandParameter="{Binding}">
                                    <MenuItem.Icon>
                                        <materialIcons:MaterialIcon Kind="Delete" Width="16" Height="16" Foreground="{DynamicResource Foreground}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Border.ContextMenu>
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Border Grid.Column="0"
                                    Margin="0,0,15,0"
                                    Padding="4"
                                    VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="{Binding Type, Converter={StaticResource ClipboardItemTypeToIconConverter}}"
                                                            Width="16"
                                                            Height="16"
                                                            Foreground="{DynamicResource Foreground}" />
                            </Border>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding PreviewText}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,15,0"
                                       Foreground="{DynamicResource Foreground}"
                                       FontSize="16"
                                       FontFamily="{DynamicResource AppFontFamily}"
                                       TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       Margin="0,0,30,0"
                                       Text="{Binding CreatedAtLocal, StringFormat='{}{0:dd MMM, hh:mm tt}'}"
                                       Foreground="{DynamicResource Foreground}"
                                       FontSize="14"
                                       FontFamily="{DynamicResource AppFontFamily}" />

                            <StackPanel Grid.Column="3"
                                        Orientation="Horizontal"
                                        Spacing="15">

                                <Button Classes="icon-button"
                                        VerticalAlignment="Center"
                                        Width="30" Height="30"
                                        Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).TogglePinCommand}"
                                        CommandParameter="{Binding}"
                                        ToolTip.Tip="{Binding IsPinned, Converter={StaticResource PinStateToToolTipConverter}}">
                                    <materialIcons:MaterialIcon Kind="{Binding IsPinned, Converter={StaticResource PinStateToIconConverter}}"
                                                                Width="18"
                                                                Height="18"
                                                                Foreground="{DynamicResource Foreground}" />
                                </Button>

                                <Button Classes="icon-button"
                                        VerticalAlignment="Center"
                                        Width="30" Height="30"
                                        IsEnabled="{Binding !IsDeleting}"
                                        Command="{Binding $parent[UserControl].((vm:HomeViewModel)DataContext).DeleteItemClickedCommand}"
                                        CommandParameter="{Binding}">
                                    <materialIcons:MaterialIcon Kind="Close"
                                                                Width="20"
                                                                Height="20"
                                                                Foreground="{DynamicResource Foreground}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>