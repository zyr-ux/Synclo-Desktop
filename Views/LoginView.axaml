<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Synclo.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
             x:Class="Synclo.Views.LoginView"
             x:DataType="vm:LoginViewModel"
             Background="{DynamicResource PrimaryBackground}">

    <Grid HorizontalAlignment="Center"
          VerticalAlignment="Center"
          RowDefinitions="Auto, Auto, 50, Auto, Auto"
          Margin="0 20 0 0">

        <StackPanel Grid.Row="0" Spacing="20" Margin="0 0 0 50">
            <TextBlock Text="E-mail"
                       FontFamily="{DynamicResource Inconsolata-Bold}"
                       FontSize="24" />
            <TextBox Background="Transparent"
                     BorderThickness="0 0 0 1"
                     CornerRadius="0"
                     Padding="3"
                     Width="300"
                     FontSize="18"
                     FontFamily="{DynamicResource Inconsolata-Medium}"
                     Text="{Binding Email}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="20" Margin="0 0 0 10">
            <TextBlock Text="Password"
                       FontFamily="{DynamicResource Inconsolata-Bold}"
                       FontSize="24" />
            <TextBox Classes="revealPasswordButton"
                     Background="Transparent"
                     PasswordChar="*"
                     BorderThickness="0 0 0 1"
                     CornerRadius="0"
                     Padding="3"
                     Width="300"
                     FontSize="18"
                     FontFamily="{DynamicResource Inconsolata-Medium}"
                     Text="{Binding Password}" />
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Foreground="{DynamicResource Accent}"
                   FontFamily="{DynamicResource Inconsolata-Medium}"
                   FontSize="14"
                   TextWrapping="Wrap"
                   MaxWidth="300"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center" />

        <Button Grid.Row="3"
                Classes="custom-button"
                Width="200"
                Height="50"
                Content="Login"
                HorizontalAlignment="Center"
                IsEnabled="{Binding !IsBusy}"
                Command="{Binding LoginCommand}" />

        <Button Grid.Row="4"
                Content="No account? Register instead"
                Classes="textButton"
                Margin="0 35 0 0"
                HorizontalAlignment="Center"
                Command="{Binding RegisterCommand}" />
    </Grid>
</UserControl>

