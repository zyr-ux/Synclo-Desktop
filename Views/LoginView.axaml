<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Synclo.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
             x:Class="Synclo.Views.LoginView"
             x:DataType="vm:LoginViewModel">

    <Grid HorizontalAlignment="Center"
          VerticalAlignment="Center"
          RowDefinitions="Auto, Auto, 50, Auto, Auto"
          Margin="0 20 0 0">

        <StackPanel Grid.Row="0" Spacing="20" Margin="0 0 0 50">
            <TextBlock Text="E-mail"
                       FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold"
                       FontSize="24" />
            <TextBox Width="300"
                     FontSize="18"
                     FontFamily="{DynamicResource AppFontFamily}"
                     Text="{Binding Email}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="20" Margin="0 0 0 10">
            <TextBlock Text="Password"
                       FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold"
                       FontSize="24" />
            <TextBox Classes="revealPasswordButton"
                     PasswordChar="*"
                     Width="300"
                     FontSize="18"
                     FontFamily="{DynamicResource AppFontFamily}"
                     Text="{Binding Password}" />
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Foreground="{DynamicResource Accent}"
                   FontFamily="{DynamicResource AppFontFamily}"
                   FontSize="14"
                   TextWrapping="Wrap"
                   MaxWidth="300"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center" />

        <Button Grid.Row="3"
                Classes="custom-button"
                Width="200"
                Height="50"
                Content="{Binding SubmitButtonText}"
                HorizontalAlignment="Center"
                IsEnabled="{Binding !IsBusy}"
                Command="{Binding SubmitCommand}" />

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0 35 0 0"
                    Spacing="6">
            <!-- Login Mode Footer -->
            <TextBlock Text="Don't have an account?"
                       IsVisible="{Binding !IsRegisterMode}"
                       FontFamily="{DynamicResource AppFontFamily}"
                       FontSize="16"
                       Foreground="{DynamicResource Foreground}"
                       VerticalAlignment="Center" />
            <Button Content="Register now"
                    IsVisible="{Binding !IsRegisterMode}"
                    Classes="hyperlinkButton"
                    VerticalAlignment="Center"
                    IsEnabled="{Binding !IsBusy}"
                    Command="{Binding SwitchModeCommand}" />

            <!-- Register Mode Footer -->
            <TextBlock Text="Already have an account?"
                       IsVisible="{Binding IsRegisterMode}"
                       FontFamily="{DynamicResource AppFontFamily}"
                       FontSize="16"
                       Foreground="{DynamicResource Foreground}"
                       VerticalAlignment="Center" />
            <Button Content="Log in"
                    IsVisible="{Binding IsRegisterMode}"
                    Classes="hyperlinkButton"
                    VerticalAlignment="Center"
                    IsEnabled="{Binding !IsBusy}"
                    Command="{Binding SwitchModeCommand}" />
        </StackPanel>
    </Grid>
</UserControl>

