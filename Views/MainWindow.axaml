<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Synclo.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
        x:Class="Synclo.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Synclo"
        Width="950" Height="600"
        WindowStartupLocation="CenterScreen"
        MinWidth="200"
        MinHeight="350">
    
    <Grid ColumnDefinitions="200,*">

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{DynamicResource SecondaryBackground}"
                Padding="0 20 0 10">

            <DockPanel LastChildFill="True">

                <!-- Status bar -->
                <StackPanel DockPanel.Dock="Bottom"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal"
                            Spacing="8"
                            Margin="20 0 0 10">

                    <TextBlock Text="Status:"
                               FontSize="16"
                               Foreground="{DynamicResource ForegroundL}"
                               FontFamily="{DynamicResource Inconsolata-Bold}"/>

                    <TextBlock Text="{Binding StatusText}"
                               FontSize="16"
                               FontFamily="{DynamicResource Inconsolata-Bold}"
                               Foreground="{Binding StatusColor}"/>
                </StackPanel>

                <!-- Sidebar content -->
                <StackPanel Spacing="20">

                    <TextBlock Text="Synclo"
                               Foreground="{DynamicResource ForegroundL}"
                               FontSize="43"
                               FontFamily="{DynamicResource Inconsolata-Bold}"
                               HorizontalAlignment="Left"
                               Margin="20,10,0,30" />

                    <RadioButton Classes="sidebar"
                                 GroupName="Sidebar"
                                 IsChecked="{Binding IsHomePage}"
                                 Command="{Binding ShowHomeCommand}"
                                 HorizontalContentAlignment="Left"
                                 Padding="16 0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <avalonia:MaterialIcon Kind="Home" Width="18" Height="18" />
                            <TextBlock Text="Home" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Classes="sidebar"
                                 GroupName="Sidebar"
                                 IsChecked="{Binding IsAccountPage}"
                                 Command="{Binding ShowAccountCommand}"
                                 HorizontalContentAlignment="Left"
                                 Padding="16 0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <avalonia:MaterialIcon Kind="AccountCircle" Width="18" Height="18" />
                            <TextBlock Text="Account" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Classes="sidebar"
                                 GroupName="Sidebar"
                                 IsChecked="{Binding IsSettingsPage}"
                                 Command="{Binding ShowSettingsCommand}"
                                 HorizontalContentAlignment="Left"
                                 Padding="16 0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <avalonia:MaterialIcon Kind="Settings" Width="18" Height="18" />
                            <TextBlock Text="Settings" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- Main content -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>