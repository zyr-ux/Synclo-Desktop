<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Synclo.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
        x:Class="Synclo.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Synclo"
        Width="1000" Height="600"
        WindowStartupLocation="CenterScreen"
        MinWidth="200"
        MinHeight="350"
        Background="{DynamicResource PrimaryBackground}"
        ExtendClientAreaToDecorationsHint="True"
        WindowDecorations="Full">

    <Window.Styles>
        <Style Selector="Button#PART_FullScreenButton">
            <Setter Property="Width" Value="0" />
            <Setter Property="MaxWidth" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="250,*">

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Padding="0 10 0 10"
                Margin="10"
                CornerRadius="10"
                BoxShadow="0 1 3 0 #30000000, 0 4 5 0 #15000000"
                Background="{DynamicResource SecondaryBackground}">

            <DockPanel LastChildFill="True">

                <!-- Status bar -->
                <StackPanel DockPanel.Dock="Bottom"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal"
                            Spacing="8"
                            Margin="20 0 0 10">

                    <TextBlock Text="Status:"
                               FontSize="18"
                               Foreground="{DynamicResource ForegroundL}"
                               FontFamily="{DynamicResource Inconsolata-Medium}" />

                    <TextBlock FontSize="18"
                               FontFamily="{DynamicResource Inconsolata-Medium}"
                               Tag="{Binding ConnectionStatus}">
                        <TextBlock.Styles>
                            <Style Selector="TextBlock[Tag=Online]">
                                <Setter Property="Foreground" Value="{DynamicResource StatusOnline}" />
                                <Setter Property="Text" Value="Online" />
                            </Style>
                            <Style Selector="TextBlock[Tag=Offline]">
                                <Setter Property="Foreground" Value="{DynamicResource StatusOffline}" />
                                <Setter Property="Text" Value="Offline" />
                            </Style>
                            <Style Selector="TextBlock[Tag=NoInternet]">
                                <Setter Property="Foreground" Value="{DynamicResource StatusNoInternet}" />
                                <Setter Property="Text" Value="No Internet" />
                            </Style>
                        </TextBlock.Styles>
                    </TextBlock>
                </StackPanel>

                <!-- Divider above status bar -->
                <Border DockPanel.Dock="Bottom"
                        Height="1"
                        Background="{DynamicResource Accent}"
                        Opacity="0.5"
                        Margin="10 0 10 20" />

                <!-- Sidebar content -->
                <StackPanel Spacing="10" Orientation="Vertical">

                    <TextBlock Text="Synclo"
                               Foreground="{DynamicResource Accent}"
                               FontSize="43"
                               FontFamily="{DynamicResource Inconsolata-Bold}"
                               HorizontalAlignment="Left"
                               Margin="20,10,20,0" />

                    <Border Height="1"
                            Background="{DynamicResource Accent}"
                            Opacity="0.5"
                            Margin="10 0 10 20" />

                    <RadioButton Classes="sidebar"
                                 GroupName="Sidebar"
                                 IsChecked="{Binding IsHomePage}"
                                 Command="{Binding ShowHomeCommand}"
                                 HorizontalContentAlignment="Left"
                                 Padding="16 0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <avalonia:MaterialIcon Kind="Home" Width="18" Height="18" />
                            <TextBlock Text="Home" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Classes="sidebar"
                                 GroupName="Sidebar"
                                 IsChecked="{Binding IsAccountPage}"
                                 Command="{Binding ShowAccountCommand}"
                                 HorizontalContentAlignment="Left"
                                 Padding="16 0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <avalonia:MaterialIcon Kind="Account" Width="18" Height="18" />
                            <TextBlock Text="Account" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Classes="sidebar"
                                 GroupName="Sidebar"
                                 IsChecked="{Binding IsSettingsPage}"
                                 Command="{Binding ShowSettingsCommand}"
                                 HorizontalContentAlignment="Left"
                                 Padding="16 0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <avalonia:MaterialIcon Kind="Settings" Width="18" Height="18" />
                            <TextBlock Text="Settings" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main content -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>