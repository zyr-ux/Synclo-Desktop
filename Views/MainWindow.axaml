<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Synclo.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:converters="using:Synclo.Converters"
        xmlns:behaviors="using:Synclo.Behaviors"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
        x:Class="Synclo.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Synclo"
        Width="1000" Height="600"
        WindowStartupLocation="CenterScreen"
        MinWidth="200"
        MinHeight="350"
        Background="{DynamicResource PrimaryBackground}"
        ExtendClientAreaToDecorationsHint="True"
        SystemDecorations="Full"
        Padding="{Binding $self.OffScreenMargin}">

    <Window.Resources>
        <converters:ConnectionStatusToTextConverter x:Key="ConnectionStatusToTextConverter" />
        <converters:ConnectionStatusToBrushConverter x:Key="ConnectionStatusToBrushConverter" />
    </Window.Resources>

    <Grid ColumnDefinitions="Auto,*">

        <!-- Title Bar -->
        <StackPanel x:Name="TitleBarContainer"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Height="40"
                    Orientation="Horizontal"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left"
                    Spacing="8"
                    Margin="16,0,0,0"
                    IsHitTestVisible="False">
                    <!-- Make this image controller use a 16x16 png for proper title bar logo scaling-->
            <Image Source="avares://Synclo/Assets/avalonia-logo.ico"
                   Width="16"
                   Height="16"
                   RenderOptions.BitmapInterpolationMode="HighQuality"
                   VerticalAlignment="Center"/>
            <TextBlock Text="Synclo"
                       FontSize="12"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            
            <!-- Dynamic Status Dot (Orb) -->
            <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                <Ellipse.Fill>
                    <MultiBinding Converter="{StaticResource ConnectionStatusToBrushConverter}">
                        <Binding Path="ConnectionStatus" />
                        <Binding Path="ActualThemeVariant" Source="{x:Static Application.Current}" />
                    </MultiBinding>
                </Ellipse.Fill>
            </Ellipse>
        </StackPanel>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Width="{Binding SidebarWidth}"
                Padding="0 50 0 10"
                ClipToBounds="True">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.2" Easing="CubicEaseInOut" />
                </Transitions>
            </Border.Transitions>

            <DockPanel LastChildFill="True">
                <RadioButton Classes="sidebar"
                             GroupName="Sidebar"
                             DockPanel.Dock="Bottom"
                             IsChecked="{Binding IsAboutPage}"
                             Command="{Binding ShowAboutCommand}"
                             HorizontalContentAlignment="Stretch"
                             Padding="0"
                             ToolTip.Placement="Right"
                             ToolTip.Tip="About"
                             ToolTip.ServiceEnabled="{Binding IsSidebarCollapsed}">
                    <Grid ColumnDefinitions="40,*">
                        <avalonia:MaterialIcon Grid.Column="0" Kind="AboutCircleOutline" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="About" VerticalAlignment="Center" IsVisible="{Binding !IsSidebarCollapsed}" />
                    </Grid>
                </RadioButton>

                <!-- Sidebar content -->
                <StackPanel Spacing="5" Orientation="Vertical">

                    <!-- <TextBlock Text="Synclo" -->
                    <!--            Foreground="{DynamicResource Accent}" -->
                    <!--            FontSize="43" -->
                    <!--            FontWeight="Bold" -->
                    <!--            HorizontalAlignment="Left" -->
                    <!--            Margin="20,10,20,0" /> -->
                    <!-- -->
                    <!-- <Border Height="1" -->
                    <!--         Background="{DynamicResource Accent}" -->
                    <!--         Opacity="0.5" -->
                    <!--         Margin="10 0 10 20" /> -->

                    <Button Classes="sidebar"
                            Command="{Binding ToggleSidebarCommand}"
                            HorizontalAlignment="Left"
                            Width="40"
                            Padding="0">
                        <avalonia:MaterialIcon Kind="Menu" Width="20" Height="20" />
                    </Button>
                    
                    <RadioButton Classes="sidebar"
                                 GroupName="Sidebar"
                                 IsChecked="{Binding IsHomePage}"
                                 Command="{Binding ShowHomeCommand}"
                                 HorizontalContentAlignment="Stretch"
                                 Padding="0"
                                 ToolTip.Placement="Right"
                                 ToolTip.Tip="Home"
                                 ToolTip.ServiceEnabled="{Binding IsSidebarCollapsed}">
                        <Grid ColumnDefinitions="40,*">
                            <avalonia:MaterialIcon Grid.Column="0" Kind="HomeVariantOutline" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Home" VerticalAlignment="Center" IsVisible="{Binding !IsSidebarCollapsed}" />
                        </Grid>
                    </RadioButton>

                    <RadioButton Classes="sidebar"
                                 GroupName="Sidebar"
                                 IsChecked="{Binding IsAccountPage}"
                                 Command="{Binding ShowAccountCommand}"
                                 HorizontalContentAlignment="Stretch"
                                 Padding="0"
                                 ToolTip.Placement="Right"
                                 ToolTip.Tip="Account"
                                 ToolTip.ServiceEnabled="{Binding IsSidebarCollapsed}">
                        <Grid ColumnDefinitions="40,*">
                            <avalonia:MaterialIcon Grid.Column="0" Kind="AccountOutline" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Account" VerticalAlignment="Center" IsVisible="{Binding !IsSidebarCollapsed}" />
                        </Grid>
                    </RadioButton>

                    <RadioButton Classes="sidebar"
                                 GroupName="Sidebar"
                                 IsChecked="{Binding IsSettingsPage}"
                                 Command="{Binding ShowSettingsCommand}"
                                 HorizontalContentAlignment="Stretch"
                                 Padding="0"
                                 ToolTip.Placement="Right"
                                 ToolTip.Tip="Settings"
                                 ToolTip.ServiceEnabled="{Binding IsSidebarCollapsed}">
                        <Grid ColumnDefinitions="40,*">
                            <avalonia:MaterialIcon Grid.Column="0" Kind="SettingsOutline" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Settings" VerticalAlignment="Center" IsVisible="{Binding !IsSidebarCollapsed}" />
                        </Grid>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main content -->
        <Border x:Name="ContentBorder"
                Grid.Column="1"
                Margin="0,40,0,0"
                CornerRadius="10 0 0 0"
                Background="{DynamicResource SecondaryBackground}"
                ClipToBounds="True"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="1">
            <TransitioningContentControl Content="{Binding CurrentViewModel}">
    <TransitioningContentControl.PageTransition>
        <behaviors:PageTransition />
    </TransitioningContentControl.PageTransition>
</TransitioningContentControl>
        </Border>

        <!-- Dialog Overlay for Dimming/Fade Effect -->
        <Panel Grid.Column="0" Grid.ColumnSpan="2"
               Background="#000000"
               IsHitTestVisible="{Binding IsDialogOpen}">
            <Panel.Styles>
                <Style Selector="Panel">
                    <Setter Property="Opacity" Value="0.0" />
                </Style>
                <Style Selector="Panel[IsHitTestVisible=True]">
                    <Setter Property="Opacity" Value="0.45" />
                </Style>
            </Panel.Styles>
            <Panel.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="SineEaseInOut" />
                </Transitions>
            </Panel.Transitions>
        </Panel>
    </Grid>
</Window>