<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Synclo.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
        x:Class="Synclo.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Synclo"
        Width="1000" Height="600"
        WindowStartupLocation="CenterScreen"
        MinWidth="200"
        MinHeight="350"
        Background="{DynamicResource PrimaryBackground}"
        ExtendClientAreaToDecorationsHint="True"
        SystemDecorations="Full"
        Padding="{Binding $self.OffScreenMargin}">

    <Grid ColumnDefinitions="200,*">

        <!-- Title Bar -->
        <StackPanel x:Name="TitleBarContainer"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Height="40"
                    Orientation="Horizontal"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left"
                    Spacing="12"
                    Margin="16,0,0,0"
                    IsHitTestVisible="False">
                    <!-- Make this image controller use a 16x16 png for proper title bar logo scaling-->
            <Image Source="avares://Synclo/Assets/avalonia-logo.ico"
                   Width="16"
                   Height="16"
                   RenderOptions.BitmapInterpolationMode="HighQuality"
                   VerticalAlignment="Center"/>
            <TextBlock Text="Synclo"
                       FontSize="12"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Padding="0 100 0 10">

            <DockPanel LastChildFill="True">

                <!-- Status bar -->
                <!-- <StackPanel DockPanel.Dock="Bottom" -->
                <!--             HorizontalAlignment="Left" -->
                <!--             Orientation="Horizontal" -->
                <!--             Spacing="8" -->
                <!--             Margin="20 0 0 10"> -->
                <!-- -->
                <!--     <TextBlock Text="Status:" -->
                <!--                FontSize="18" -->
                <!--                Foreground="{DynamicResource Foreground}" -->
                <!--                FontFamily="{DynamicResource Inconsolata-Medium}" /> -->
                <!-- -->
                <!--     <TextBlock FontSize="18" -->
                <!--                FontFamily="{DynamicResource Inconsolata-Medium}" -->
                <!--                Tag="{Binding ConnectionStatus}"> -->
                <!--         <TextBlock.Styles> -->
                <!--             <Style Selector="TextBlock[Tag=Online]"> -->
                <!--                 <Setter Property="Foreground" Value="{DynamicResource StatusOnline}" /> -->
                <!--                 <Setter Property="Text" Value="Online" /> -->
                <!--             </Style> -->
                <!--             <Style Selector="TextBlock[Tag=Offline]"> -->
                <!--                 <Setter Property="Foreground" Value="{DynamicResource StatusOffline}" /> -->
                <!--                 <Setter Property="Text" Value="Offline" /> -->
                <!--             </Style> -->
                <!--             <Style Selector="TextBlock[Tag=NoInternet]"> -->
                <!--                 <Setter Property="Foreground" Value="{DynamicResource StatusNoInternet}" /> -->
                <!--                 <Setter Property="Text" Value="No Internet" /> -->
                <!--             </Style> -->
                <!--         </TextBlock.Styles> -->
                <!--     </TextBlock> -->
                <!-- </StackPanel> -->

                <!-- Divider above status bar -->
                <!-- <Border DockPanel.Dock="Bottom" -->
                <!--         Height="1" -->
                <!--         Background="{DynamicResource Accent}" -->
                <!--         Opacity="0.5" -->
                <!--         Margin="10 0 10 20" /> -->

                <!-- Sidebar content -->
                <StackPanel Spacing="5" Orientation="Vertical">

                    <!-- <TextBlock Text="Synclo" -->
                    <!--            Foreground="{DynamicResource Accent}" -->
                    <!--            FontSize="43" -->
                    <!--            FontFamily="{DynamicResource Inconsolata-Bold}" -->
                    <!--            HorizontalAlignment="Left" -->
                    <!--            Margin="20,10,20,0" /> -->
                    <!-- -->
                    <!-- <Border Height="1" -->
                    <!--         Background="{DynamicResource Accent}" -->
                    <!--         Opacity="0.5" -->
                    <!--         Margin="10 0 10 20" /> -->

                    <RadioButton Classes="sidebar"
                                 GroupName="Sidebar"
                                 IsChecked="{Binding IsHomePage}"
                                 Command="{Binding ShowHomeCommand}"
                                 HorizontalContentAlignment="Left"
                                 Padding="10 0 5 0">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <avalonia:MaterialIcon Kind="HomeVariantOutline" Width="20" Height="20" />
                            <TextBlock Text="Home" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Classes="sidebar"
                                 GroupName="Sidebar"
                                 IsChecked="{Binding IsAccountPage}"
                                 Command="{Binding ShowAccountCommand}"
                                 HorizontalContentAlignment="Left"
                                 Padding="10 0 5 0">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <avalonia:MaterialIcon Kind="AccountOutline" Width="20" Height="20" />
                            <TextBlock Text="Account" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Classes="sidebar"
                                 GroupName="Sidebar"
                                 IsChecked="{Binding IsSettingsPage}"
                                 Command="{Binding ShowSettingsCommand}"
                                 HorizontalContentAlignment="Left"
                                 Padding="10 0 5 0">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <avalonia:MaterialIcon Kind="SettingsOutline" Width="20" Height="20" />
                            <TextBlock Text="Settings" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main content -->
        <Border x:Name="ContentBorder"
                Grid.Column="1"
                Margin="0,40,0,0"
                CornerRadius="10 0 0 0"
                Background="{DynamicResource SecondaryBackground}"
                ClipToBounds="True"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="1">
            <ContentControl Content="{Binding CurrentViewModel}" />
        </Border>

        <!-- Dialog Overlay for Dimming/Fade Effect -->
        <Panel Grid.Column="0" Grid.ColumnSpan="2"
               Background="#000000"
               IsHitTestVisible="{Binding IsDialogOpen}">
            <Panel.Styles>
                <Style Selector="Panel">
                    <Setter Property="Opacity" Value="0.0" />
                </Style>
                <Style Selector="Panel[IsHitTestVisible=True]">
                    <Setter Property="Opacity" Value="0.45" />
                </Style>
            </Panel.Styles>
            <Panel.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" Easing="SineEaseInOut" />
                </Transitions>
            </Panel.Transitions>
        </Panel>
    </Grid>
</Window>