<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ia="using:Xaml.Behaviors.Interactions.Animated"
             xmlns:vm="using:Synclo.ViewModels"
             xmlns:converters="using:Synclo.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Synclo.Views.AccountDetailsView"
             x:DataType="vm:AccountDetailsViewModel">

    <UserControl.Resources>
        <converters:OSToIconConverter x:Key="OsToIconConverter" />
    </UserControl.Resources>

    <Grid>
        <!-- Page padding -->
        <Border Padding="30">
            <Grid RowDefinitions="Auto,Auto,Auto,*">
                <!-- Header -->
                <StackPanel Grid.Row="0"
                            Margin="0,0,0,20"
                            Orientation="Vertical">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="10">
                        <TextBlock Text="Welcome,"
                                   FontSize="32"
                                   Foreground="{DynamicResource Foreground}"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding Username}"
                                   FontSize="36"
                                   FontWeight="Bold"
                                   FontFamily="{StaticResource Inconsolata}"
                                   Foreground="{DynamicResource Accent}"
                                   />
                    </StackPanel>
                    
                    <Border Height="1"
                            Background="{DynamicResource Accent}"
                            Opacity="0.5"
                            Margin="-5 18 -5 0" />
                </StackPanel>


                <!-- Title -->
                <TextBlock Grid.Row="1"
                           Text="Manage Devices"
                           FontSize="32"
                           Foreground="{DynamicResource Foreground}"
                           FontWeight="Bold"
                           Margin="0,0,0,20" />

                <!-- Devices card -->
                <Grid Grid.Row="2">
                    <!-- background -->
                    <Border Background="{DynamicResource Gray}"
                            CornerRadius="5" />

                    <!-- content -->
                    <Border Padding="20"
                            Background="Transparent"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="1"
                            CornerRadius="5">

                        <!-- ONLY scrollable area -->
                        <ScrollViewer MaxHeight="250"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <Interaction.Behaviors>
                                <ia:VerticalScrollViewerAnimatedBehavior />
                            </Interaction.Behaviors>

                            <ItemsControl ItemsSource="{Binding Devices}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="15" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="10"
                                                        VerticalAlignment="Center">
                                                
                                                <!-- OS Icon -->
                                                <materialIcons:MaterialIcon Kind="{Binding os, Converter={StaticResource OsToIconConverter}}"
                                                                            Width="18"
                                                                            Height="18"
                                                                            Foreground="{DynamicResource Foreground}" />
                                                
                                                <TextBlock Text="{Binding device_name}"
                                                           FontSize="18"
                                                           Foreground="{DynamicResource Foreground}"
                                                           FontWeight="Bold" />
                                                <TextBlock Text=" - this device"
                                                           FontSize="18"
                                                           Foreground="{DynamicResource TextMuted}"
                                                           IsVisible="{Binding IsThisDevice}"
                                                           FontWeight="Bold" />
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Content="Logout"
                                                    Classes="textButton"
                                                    IsVisible="{Binding !IsThisDevice}"
                                                    Command="{Binding $parent[UserControl].((vm:AccountDetailsViewModel)DataContext).LogoutDeviceCommand}"
                                                    CommandParameter="{Binding device_id}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Actions -->
                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Right"
                            Spacing="20"
                            Margin="0,20,0,0">

                    <Button Classes="custom-button"
                            Content="Delete Account"
                            Width="150"
                            Height="50"
                            Command="{Binding DeleteAccountCommand}"
                            IsEnabled="{Binding !IsBusy}" />

                    <Button Classes="custom-button"
                            Content="Reset Password"
                            Width="150"
                            Height="50"
                            Command="{Binding ResetPasswordCommand}"
                            IsEnabled="{Binding !IsBusy}" />

                    <Button Classes="custom-button"
                            Content="Logout"
                            Width="100"
                            Height="50"
                            Command="{Binding LogoutCommand}"
                            IsEnabled="{Binding !IsBusy}" />
                </StackPanel>

            </Grid>

        </Border>

    </Grid>
</UserControl>