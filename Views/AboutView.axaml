<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:Synclo.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Synclo.Views.AboutView"
             x:DataType="vm:AboutViewModel">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Border Padding="30">
            <StackPanel Spacing="25">
                
                <!-- Top section: App Logo & Basic info -->
                <Grid ColumnDefinitions="Auto,*" Margin="0,10,0,10">
                    <!-- Logo container -->
                    <Border Grid.Column="0"
                            Width="80"
                            Height="80"
                            CornerRadius="20"
                            Background="{DynamicResource PrimaryBackground}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="1.5"
                            Margin="0,0,24,0"
                            ClipToBounds="True">
                        <Image Source="avares://Synclo/Assets/avalonia-logo.ico"
                               Width="48"
                               Height="48"
                               RenderOptions.BitmapInterpolationMode="HighQuality"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />
                    </Border>
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom">
                            <TextBlock Text="Synclo"
                                       FontSize="28"
                                       FontFamily="{DynamicResource Inconsolata-Bold}"
                                       Foreground="{DynamicResource Foreground}" />
                            <TextBlock Text="{Binding Version, StringFormat='v{0}'}"
                                       FontSize="16"
                                       FontFamily="{DynamicResource Inconsolata-Medium}"
                                       Foreground="{DynamicResource Foreground}"
                                       Opacity="0.6"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,0,4" />
                        </StackPanel>
                        <TextBlock Text="Secure, end-to-end encrypted clipboard synchronization."
                                   FontSize="15"
                                   FontFamily="{DynamicResource Inconsolata-Medium}"
                                   Foreground="{DynamicResource Foreground}"
                                   Opacity="0.7"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <!-- Cards section -->
                <StackPanel Spacing="12">
                    <!-- Status Card -->
                    <Border CornerRadius="8"
                            BorderThickness="1"
                            Padding="12"
                            BorderBrush="{DynamicResource Border}"
                            Tag="{Binding ConnectionStatus}">
                        <Border.Background>
                            <SolidColorBrush Color="{DynamicResource SystemBaseHighColor}" Opacity="0.05" />
                        </Border.Background>
                        
                        <Border.Styles>
                            <!-- Default: hide pulsating orb -->
                            <Style Selector="Grid#StatusOrb">
                                <Setter Property="IsVisible" Value="False" />
                            </Style>
                            
                            <!-- Online State -->
                            <Style Selector="Border[Tag=Online] TextBlock#StatusText">
                                <Setter Property="Text" Value="Online" />
                                <Setter Property="Foreground" Value="{DynamicResource StatusOnline}" />
                            </Style>
                            <Style Selector="Border[Tag=Online] materialIcons|MaterialIcon#StatusIcon">
                                <Setter Property="IsVisible" Value="False" />
                            </Style>
                            <Style Selector="Border[Tag=Online] Grid#StatusOrb">
                                <Setter Property="IsVisible" Value="True" />
                            </Style>
                            <Style Selector="Border[Tag=Online] Ellipse#StatusOrbRipple">
                                <Style.Animations>
                                    <Animation Duration="0:0:1.5" IterationCount="Infinite">
                                        <KeyFrame Cue="0%">
                                            <Setter Property="ScaleTransform.ScaleX" Value="1" />
                                            <Setter Property="ScaleTransform.ScaleY" Value="1" />
                                            <Setter Property="Opacity" Value="0.6" />
                                        </KeyFrame>
                                        <KeyFrame Cue="100%">
                                            <Setter Property="ScaleTransform.ScaleX" Value="2.5" />
                                            <Setter Property="ScaleTransform.ScaleY" Value="2.5" />
                                            <Setter Property="Opacity" Value="0" />
                                        </KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>

                            <!-- Offline State -->
                            <Style Selector="Border[Tag=Offline] TextBlock#StatusText">
                                <Setter Property="Text" Value="Offline" />
                                <Setter Property="Foreground" Value="{DynamicResource StatusOffline}" />
                            </Style>
                            <Style Selector="Border[Tag=Offline] materialIcons|MaterialIcon#StatusIcon">
                                <Setter Property="Kind" Value="Close" />
                                <Setter Property="Foreground" Value="{DynamicResource StatusOffline}" />
                            </Style>

                            <!-- NoInternet State -->
                            <Style Selector="Border[Tag=NoInternet] TextBlock#StatusText">
                                <Setter Property="Text" Value="No Internet" />
                                <Setter Property="Foreground" Value="{DynamicResource StatusNoInternet}" />
                            </Style>
                            <Style Selector="Border[Tag=NoInternet] materialIcons|MaterialIcon#StatusIcon">
                                <Setter Property="Kind" Value="AlertCircleOutline" />
                                <Setter Property="Foreground" Value="{DynamicResource StatusNoInternet}" />
                            </Style>
                        </Border.Styles>

                        <Grid ColumnDefinitions="*,Auto">
                            <!-- Left side: Status Text and Status Icon inline -->
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="Server Status:"
                                           FontFamily="{DynamicResource Inconsolata-Medium}"
                                           FontSize="16"
                                           Foreground="{DynamicResource Foreground}"
                                           VerticalAlignment="Center" />
                                
                                <TextBlock Name="StatusText"
                                           FontFamily="{DynamicResource Inconsolata-Medium}"
                                           FontSize="16"
                                           VerticalAlignment="Center" />
                                
                                <materialIcons:MaterialIcon Name="StatusIcon"
                                                            Width="16"
                                                            Height="16"
                                                            VerticalAlignment="Center" />
                                
                                <!-- Pulsating status orb (visible only when Online) -->
                                <Grid Name="StatusOrb" VerticalAlignment="Center">
                                    <Ellipse Name="StatusOrbRipple"
                                             Width="10" Height="10"
                                             Fill="{DynamicResource StatusOnline}"
                                             Opacity="0"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             RenderTransformOrigin="50%,50%" />
                                    <Ellipse Width="10" Height="10"
                                             Fill="{DynamicResource StatusOnline}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                            
                            <!-- Right side: Refresh button -->
                            <Button Grid.Column="1"
                                    Classes="icon-button"
                                    Command="{Binding CheckStatusManualCommand}"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="Refresh Server Status">
                                <materialIcons:MaterialIcon Kind="Refresh"
                                                            Width="26"
                                                            Height="26" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Links Card -->
                    <Border CornerRadius="8"
                            BorderThickness="1"
                            Padding="12"
                            BorderBrush="{DynamicResource Border}">
                        <Border.Background>
                            <SolidColorBrush Color="{DynamicResource SystemBaseHighColor}" Opacity="0.05" />
                        </Border.Background>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Links &amp; Resources"
                                           FontFamily="{DynamicResource Inconsolata-Bold}"
                                           FontSize="16"
                                           Foreground="{DynamicResource Foreground}" />
                                <TextBlock Text="Find documentation, source code, or report bugs."
                                           FontFamily="{DynamicResource Inconsolata-Medium}"
                                           FontSize="13"
                                           Foreground="{DynamicResource Foreground}"
                                           Opacity="0.7" />
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <!-- <Button Classes="custom-button" -->
                                <!--         Content="GitHub" -->
                                <!--         Width="100" -->
                                <!--         Height="36" -->
                                <!--         Command="{Binding OpenGitHubCommand}" /> -->
                                <!-- <Button Classes="custom-button" -->
                                <!--         Content="Report Issue" -->
                                <!--         Width="130" -->
                                <!--         Height="36" -->
                                <!--         Command="{Binding OpenIssuesCommand}" /> -->
                                <Button
                                    Classes="icon-button"
                                    Command="{Binding OpenGitHubCommand}"
                                    ToolTip.Tip="Open Github"
                                    ToolTip.Placement="Left">
                                    <materialIcons:MaterialIcon
                                        Kind="Github"
                                        Width="26"
                                        Height="26"/>
                                </Button>
                                
                                <Button
                                    Classes="icon-button"
                                    Command="{Binding OpenIssuesCommand}"
                                    ToolTip.Tip="Open Issues"
                                    ToolTip.Placement="Right">
                                    <materialIcons:MaterialIcon
                                        Kind="GitIssue"
                                        Width="26"
                                        Height="26"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Bottom Area / Footer -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0" VerticalAlignment="Bottom">
                    <!-- Left: Powered by Avalonia -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="Powered by"
                                   FontSize="16"
                                   FontFamily="{DynamicResource Inconsolata-Medium}"
                                   Foreground="{DynamicResource Foreground}"
                                   VerticalAlignment="Center" />
                        <Svg Path="avares://Synclo/Assets/avalonia.svg"
                               Height="22"
                               Css="* { fill: #007DF9; }"
                               VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right: License/Footer -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="Released under the GPL-3.0 License"
                                   FontFamily="{DynamicResource Inconsolata-Medium}"
                                   FontSize="14"
                                   Foreground="{DynamicResource Foreground}"
                                   Opacity="0.5"
                                   HorizontalAlignment="Right" />
                        <!-- <TextBlock Text="Copyright © 2026 Synclo Contributors"
                                   FontFamily="{DynamicResource Inconsolata-Medium}"
                                   FontSize="12"
                                   Foreground="{DynamicResource Foreground}"
                                   Opacity="0.5"
                                   HorizontalAlignment="Right" /> -->
                    </StackPanel>
                </Grid>
                
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
