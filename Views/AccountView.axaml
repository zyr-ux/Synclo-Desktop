<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Synclo.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
             x:Class="Synclo.Views.AccountView"
             x:DataType="vm:AccountViewModel"
             x:Name="Root"
             Background="{DynamicResource PrimaryBackground}">

    <Grid>
        <!-- Login View-->
        <Grid Background="{DynamicResource PrimaryBackground}"
              IsVisible="{Binding IsLoggedIn, Converter={StaticResource InverseBooleanConverter}}">

            <StackPanel
                Orientation="Vertical"
                Spacing="60"
                Margin="0 60 0 0"
                HorizontalAlignment="Center">

                <!--Fields-->
                <StackPanel
                    Orientation="Vertical"
                    HorizontalAlignment="Left"
                    Spacing="20">
                    <TextBlock Text="E-mail"
                               HorizontalAlignment="Left"
                               FontFamily="{DynamicResource Inconsolata-Bold}"
                               FontSize="24" />

                    <TextBox
                        Background="Transparent"
                        Margin="0 10 0 0"
                        BorderThickness="0 0 0 1"
                        CornerRadius="0"
                        Padding="3"
                        Width="300"
                        FontSize="18"
                        FontFamily="{DynamicResource Inconsolata-Medium}"
                        Text="{Binding Email}" />
                </StackPanel>

                <StackPanel
                    Orientation="Vertical"
                    HorizontalAlignment="Left"
                    Spacing="20">
                    <TextBlock Text="Password"
                               HorizontalAlignment="Left"
                               FontFamily="{DynamicResource Inconsolata-Bold}"
                               FontSize="24" />

                    <TextBox Classes="revealPasswordButton"
                             Background="Transparent"
                             PasswordChar="*"
                             Margin="0 10 0 0"
                             BorderThickness="0 0 0 1"
                             CornerRadius="0"
                             Padding="3"
                             Width="300"
                             FontSize="18"
                             FontFamily="{DynamicResource Inconsolata-Medium}"
                             Text="{Binding Password}" />
                </StackPanel>

                <Button
                    Width="200"
                    Height="50"
                    Margin="0 -20 0 0"
                    Content="Login"
                    FontFamily="{DynamicResource Inconsolata-Bold}"
                    FontSize="18"
                    HorizontalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    CornerRadius="10"
                    Background="{DynamicResource Accent}"
                    Foreground="{DynamicResource ForegroundD}"
                    Command="{Binding LoginCommand}" />

                <Button Content="No account? Register instead"
                        Classes="listAction"
                        Command="{Binding RegisterCommand}" />

            </StackPanel>
        </Grid>

        <!--Account Details View-->
        <Grid Margin="40"
              RowDefinitions="Auto, Auto, Auto, *"
              IsVisible="{Binding IsLoggedIn}">
            <StackPanel
                Grid.Row="0"
                Orientation="Horizontal"
                Spacing="10"
                Margin="0,0,0,20">

                <TextBlock Text="Logged in as :"
                           FontSize="28"
                           Foreground="{DynamicResource Yellow}"
                           FontFamily="{DynamicResource Inconsolata-Bold}" />

                <TextBlock Text="{Binding Username}"
                           FontFamily="{DynamicResource Inconsolata-Medium}"
                           FontSize="28"
                           Foreground="{DynamicResource Accent}"
                           Margin="0 0 0 0" />
            </StackPanel>

            <TextBlock Grid.Row="1"
                       Text="Manage Devices"
                       FontSize="36"
                       Foreground="{DynamicResource Accent}"
                       FontFamily="{DynamicResource Inconsolata-Bold}"
                       Margin="0,0,0,15" />
            <!--Devices-->
            <Border Grid.Row="2"
                    Background="#303030"
                    CornerRadius="12"
                    Padding="20"
                    VerticalAlignment="Top">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              MaxHeight="250">

                    <ItemsControl ItemsSource="{Binding Devices}"
                                  HorizontalAlignment="Stretch">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="15" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*, Auto">
                                    <!-- Device name -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Device name -->
                                        <TextBlock Text="{Binding device_name}"
                                                   FontFamily="{DynamicResource Inconsolata-Bold}"
                                                   Foreground="#e0e0e0"
                                                   FontSize="18"/>
                                        <!-- Suffix -->
                                        <TextBlock Text=" - this device"
                                                   FontFamily="{DynamicResource Inconsolata-Bold}"
                                                   Foreground="#666666"
                                                   FontSize="18"
                                                   IsVisible="{Binding IsThisDevice}"/>
                                    </StackPanel>
                                    <!-- Logout Button (hidden for this device) -->
                                    <Button Grid.Column="1"
                                            Content="Logout"
                                            Classes="listAction"
                                            IsVisible="{Binding IsThisDevice, Converter={StaticResource InverseBooleanConverter}}"
                                            Command="{Binding $parent[UserControl].((vm:AccountViewModel)DataContext).LogoutDeviceCommand}"
                                            CommandParameter="{Binding device_id}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Button Grid.Row="3"
                    Content="Logout"
                    Height="50"
                    FontFamily="{DynamicResource Inconsolata-Bold}"
                    Width="100"
                    FontSize="18"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    CornerRadius="10"
                    Background="{DynamicResource Accent}"
                    Foreground="{DynamicResource ForegroundD}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Command="{Binding LogoutCommand}" />
        </Grid>

    </Grid>


</UserControl>