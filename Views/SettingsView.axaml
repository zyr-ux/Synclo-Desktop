<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:Synclo.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="Synclo.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Background="{DynamicResource PrimaryBackground}">

    <!-- ScrollViewer is FLUSH to app edges -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <!-- All padding lives here -->
        <Border Padding="20">
            <StackPanel Orientation="Vertical"
                        Spacing="20">

                <!-- Theme -->
                <Border Background="{DynamicResource Accent}"
                        CornerRadius="8"
                        Padding="16">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <materialIcons:MaterialIcon
                            Kind="PaletteOutline"
                            Width="36"
                            Height="36"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource ForegroundD}" />

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Theme"
                                       FontFamily="{StaticResource Inconsolata-Bold}"
                                       FontSize="24"
                                       Foreground="{DynamicResource ForegroundD}" />
                            <TextBlock Text="Select theme to apply"
                                       FontFamily="{StaticResource Inconsolata-Medium}"
                                       FontSize="16"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource ForegroundD}" />
                        </StackPanel>

                        <ComboBox Grid.Column="2"
                                  Width="160"
                                  VerticalAlignment="Center"
                                  HorizontalContentAlignment="Left"
                                  Padding="2"
                                  FontFamily="{DynamicResource Inconsolata-Medium}"
                                  ItemsSource="{Binding AvailableThemes}"
                                  SelectedItem="{Binding SelectedTheme}" />
                    </Grid>
                </Border>
                
                <!-- Close Behavior -->
                <Border Background="{DynamicResource Accent}"
                        CornerRadius="8"
                        Padding="16">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <materialIcons:MaterialIcon
                            Kind="CloseCircleOutline"
                            Width="36"
                            Height="36"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource ForegroundD}" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Close Behaviour"
                                       FontFamily="{StaticResource Inconsolata-Bold}"
                                       FontSize="24"
                                       Foreground="{DynamicResource ForegroundD}" />
                            <TextBlock Text="What happens when you close the window?"
                                       FontFamily="{StaticResource Inconsolata-Medium}"
                                       FontSize="16"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource ForegroundD}"
                                       Opacity="0.7"/>
                        </StackPanel>

                        <ComboBox Grid.Column="2"
                                  Width="250"
                                  VerticalAlignment="Center"
                                  HorizontalContentAlignment="Left"
                                  Padding="2"
                                  FontFamily="{DynamicResource Inconsolata-Medium}"
                                  ItemsSource="{Binding AvailableCloseBehaviors}"
                                  SelectedItem="{Binding SelectedCloseBehavior}" />
                    </Grid>
                </Border>
                
                <!-- Start on boot -->
                <Border Background="Transparent"
                        CornerRadius="8"
                        Padding="16">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <materialIcons:MaterialIcon
                            Kind="Laptop"
                            Width="36"
                            Height="36"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource ForegroundL}" />

                        <TextBlock Grid.Column="1"
                                   Text="Launch on System Startup"
                                   FontFamily="{StaticResource Inconsolata-Bold}"
                                   FontSize="24"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundL}" />

                        <ToggleSwitch Grid.Column="2"
                                      IsChecked="{Binding IsStartOnBootEnabled}"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource ForegroundL}" />
                    </Grid>
                </Border>

            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>