<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:Synclo.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="Synclo.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Background="{DynamicResource PrimaryBackground}">

    <!-- ScrollViewer is FLUSH to app edges -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <!-- All padding lives here -->
        <Border Padding="20">
            <StackPanel Orientation="Vertical"
                        Spacing="20">

                <!-- Theme -->
                <Border Background="{DynamicResource Accent}"
                        CornerRadius="8"
                        Padding="16">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <materialIcons:MaterialIcon
                            Kind="PaletteOutline"
                            Width="36"
                            Height="36"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource ForegroundD}" />

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Theme"
                                       FontFamily="{StaticResource Inconsolata-Bold}"
                                       FontSize="24"
                                       Foreground="{DynamicResource ForegroundD}" />
                            <TextBlock Text="Select theme to apply"
                                       FontFamily="{StaticResource Inconsolata-Medium}"
                                       FontSize="16"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource ForegroundD}" />
                        </StackPanel>

                        <ComboBox Grid.Column="2"
                                  Width="160"
                                  VerticalAlignment="Center"
                                  HorizontalContentAlignment="Center"
                                  FontFamily="{DynamicResource Inconsolata-Medium}"
                                  ItemsSource="{Binding AvailableThemes}"
                                  SelectedItem="{Binding SelectedTheme}" />
                    </Grid>
                </Border>

                <!-- Start on boot -->
                <Border Background="{DynamicResource Accent}"
                        CornerRadius="8"
                        Padding="16">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <materialIcons:MaterialIcon
                            Kind="Laptop"
                            Width="36"
                            Height="36"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource ForegroundD}" />

                        <TextBlock Grid.Column="1"
                                   Text="Start on boot"
                                   FontFamily="{StaticResource Inconsolata-Bold}"
                                   FontSize="24"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundD}" />

                        <ToggleSwitch Grid.Column="2"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource ForegroundD}" />
                    </Grid>
                </Border>

                <!-- Background sync -->
                <Border Background="{DynamicResource Accent}"
                        CornerRadius="8"
                        Padding="16">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <materialIcons:MaterialIcon
                            Kind="Sync"
                            Width="36"
                            Height="36"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource ForegroundD}" />

                        <TextBlock Grid.Column="1"
                                   Text="Background Sync"
                                   FontFamily="{StaticResource Inconsolata-Bold}"
                                   FontSize="24"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundD}" />

                        <ToggleSwitch Grid.Column="2"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource ForegroundD}" />
                    </Grid>
                </Border>

                <!-- Minimize to tray -->
                <Border Background="{DynamicResource Accent}"
                        CornerRadius="8"
                        Padding="16">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <materialIcons:MaterialIcon
                            Kind="TrayArrowDown"
                            Width="36"
                            Height="36"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource ForegroundD}" />

                        <TextBlock Grid.Column="1"
                                   Text="Minimize to Tray"
                                   FontFamily="{StaticResource Inconsolata-Bold}"
                                   FontSize="24"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundD}" />

                        <ToggleSwitch Grid.Column="2"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource ForegroundD}" />
                    </Grid>
                </Border>

            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>