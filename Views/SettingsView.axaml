<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:Synclo.ViewModels"
             xmlns:ia="using:Xaml.Behaviors.Interactions.Animated"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="Synclo.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Interaction.Behaviors>
            <ia:VerticalScrollViewerAnimatedBehavior />
        </Interaction.Behaviors>

        <Border Padding="24,16,24,16">
            <StackPanel Orientation="Vertical" Spacing="10">
                
                <!-- APPEARANCE GROUP -->
                <Border> 
                    <StackPanel Spacing="10">
                        <TextBlock Text="Appearance"
                                   FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold"
                                   FontSize="18"
                                   Foreground="{DynamicResource Foreground}"
                                   Margin="0,8,0,4" />

                        <!-- Theme Selector -->
                        <Border Classes="SettingsItem">
                            <Grid ColumnDefinitions="Auto,*,Auto">

                                <materialIcons:MaterialIcon
                                    Kind="PaletteOutline"
                                    Width="28"
                                    Height="28"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource Foreground}" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Theme"
                                               FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold"
                                               FontSize="16"
                                               Foreground="{DynamicResource Foreground}" />

                                    <TextBlock Text="Select theme to apply"
                                               FontFamily="{DynamicResource AppFontFamily}"
                                               FontSize="13"
                                               Margin="0,4,0,0"
                                               Foreground="{DynamicResource Foreground}"
                                               Opacity="0.7"/>
                                </StackPanel>

                                <ComboBox Grid.Column="2"
                                          Width="160"
                                          VerticalAlignment="Center"
                                          HorizontalContentAlignment="Left"
                                          Padding="2"
                                          FontFamily="{DynamicResource AppFontFamily}"
                                          ItemsSource="{Binding AvailableThemes}"
                                          SelectedItem="{Binding SelectedTheme}" />
                            </Grid>
                        </Border>

                        <!-- Mica Toggle (Windows 11 only) -->
                        <Border Classes="SettingsItem" 
                                IsVisible="{Binding IsMicaToggleVisible}">
                            <Grid ColumnDefinitions="Auto,*,Auto">

                                <materialIcons:MaterialIcon
                                    Kind="Blur"
                                    Width="28"
                                    Height="28"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource Foreground}" />

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="Mica Backdrop"
                                               FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold"
                                               FontSize="16"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Foreground}" />

                                    <TextBlock Text="Enable Windows 11 Mica translucent window effect"
                                               FontFamily="{DynamicResource AppFontFamily}"
                                               FontSize="13"
                                               Margin="0,4,0,0"
                                               Foreground="{DynamicResource Foreground}"
                                               Opacity="0.7"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <ToggleSwitch Grid.Column="2"
                                              IsChecked="{Binding IsMicaEnabled}"
                                              VerticalAlignment="Center"
                                              FontFamily="{DynamicResource AppFontFamily}"
                                              Foreground="{DynamicResource Foreground}" />
                            </Grid>
                        </Border>

                        <!-- Font Family Selector -->
                        <Border Classes="SettingsItem">
                            <Grid ColumnDefinitions="Auto,*,Auto">

                                <materialIcons:MaterialIcon
                                    Kind="FormatFont"
                                    Width="28"
                                    Height="28"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource Foreground}" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Font Family"
                                               FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold"
                                               FontSize="16"
                                               Foreground="{DynamicResource Foreground}" />

                                    <TextBlock Text="Select app font family"
                                               FontFamily="{DynamicResource AppFontFamily}"
                                               FontSize="13"
                                               Margin="0,4,0,0"
                                               Foreground="{DynamicResource Foreground}"
                                               Opacity="0.7"/>
                                </StackPanel>

                                <ComboBox Grid.Column="2"
                                          Width="160"
                                          VerticalAlignment="Center"
                                          HorizontalContentAlignment="Left"
                                          Padding="2"
                                          FontFamily="{DynamicResource AppFontFamily}"
                                          ItemsSource="{Binding AvailableFonts}"
                                          SelectedItem="{Binding SelectedFont}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- GENERAL GROUP -->
                <Border> 
                    <StackPanel Spacing="10">
                        <TextBlock Text="General"
                                   FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold"
                                   FontSize="18"
                                   Foreground="{DynamicResource Foreground}"
                                   Margin="0,20,0,4" />

                        <!-- Close Behavior Selector -->
                        <Border Classes="SettingsItem">
                            <Grid ColumnDefinitions="Auto,*,Auto">

                                <materialIcons:MaterialIcon
                                    Kind="CloseCircleOutline"
                                    Width="28"
                                    Height="28"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource Foreground}" />

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="Close Behaviour"
                                               FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold"
                                               FontSize="16"
                                               Foreground="{DynamicResource Foreground}" />

                                    <TextBlock Text="What happens when you close the window?"
                                               FontFamily="{DynamicResource AppFontFamily}"
                                               FontSize="13"
                                               Margin="0,4,0,0"
                                               Foreground="{DynamicResource Foreground}"
                                               Opacity="0.7" />
                                </StackPanel>

                                <ComboBox Grid.Column="2"
                                          Width="250"
                                          VerticalAlignment="Center"
                                          HorizontalContentAlignment="Left"
                                          Padding="2"
                                          FontFamily="{DynamicResource AppFontFamily}"
                                          ItemsSource="{Binding AvailableCloseBehaviors}"
                                          SelectedItem="{Binding SelectedCloseBehavior}" />
                            </Grid>
                        </Border>

                        <!-- Right-Click Action Selector -->
                        <Border Classes="SettingsItem">
                            <Grid ColumnDefinitions="Auto,*,Auto">

                                <materialIcons:MaterialIcon
                                    Kind="Mouse"
                                    Width="28"
                                    Height="28"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource Foreground}" />

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="Right-Click Action"
                                               FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold"
                                               FontSize="16"
                                               Foreground="{DynamicResource Foreground}" />

                                    <TextBlock Text="Choose what happens when you right-click a clipboard history entry"
                                               FontFamily="{DynamicResource AppFontFamily}"
                                               FontSize="13"
                                               Margin="0,4,0,0"
                                               Foreground="{DynamicResource Foreground}"
                                               Opacity="0.7" />
                                </StackPanel>

                                <ComboBox Grid.Column="2"
                                          Width="250"
                                          VerticalAlignment="Center"
                                          HorizontalContentAlignment="Left"
                                          Padding="2"
                                          FontFamily="{DynamicResource AppFontFamily}"
                                          ItemsSource="{Binding AvailableRightClickActions}"
                                          SelectedItem="{Binding SelectedRightClickAction}" />
                            </Grid>
                        </Border>
                        
                        <!-- Server URL -->
                        <Border Classes="SettingsItem">
                            <Grid ColumnDefinitions="Auto,*,Auto">

                                <materialIcons:MaterialIcon
                                    Kind="ServerNetwork"
                                    Width="28"
                                    Height="28"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource Foreground}" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Server URL"
                                               FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold"
                                               FontSize="16"
                                               Foreground="{DynamicResource Foreground}" />
                                    <TextBlock Text="Set a custom self-hosted instance URL"
                                               FontFamily="{DynamicResource AppFontFamily}"
                                               FontSize="13"
                                               Margin="0,4,0,0"
                                               Foreground="{DynamicResource Foreground}"
                                               Opacity="0.7"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="Changing this URL will log you out and clear local history"
                                               FontFamily="{DynamicResource AppFontFamily}"
                                               FontSize="12"
                                               Margin="0,4,0,0"
                                               Foreground="OrangeRed"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                    <TextBox x:Name="ServerUrlTextBox"
                                             Width="200"
                                             VerticalAlignment="Center"
                                             FontFamily="{DynamicResource AppFontFamily}"
                                             Text="{Binding ServerUrlInput, Mode=TwoWay}"
                                             KeyDown="ServerUrl_KeyDown"
                                             Watermark="https://synclo.zyrux.dev" />

                                    <Button Classes="icon-button"
                                            Command="{Binding UpdateServerUrlCommand}"
                                            ToolTip.Tip="Confirm Server URL">
                                        <materialIcons:MaterialIcon
                                            Kind="Check"
                                            Width="20"
                                            Height="20"
                                            Foreground="{DynamicResource Foreground}" />
                                    </Button>

                                    <Button Classes="icon-button"
                                            Command="{Binding ResetServerUrlCommand}"
                                            ToolTip.Tip="Reset to Default URL">
                                        <materialIcons:MaterialIcon
                                            Kind="Undo"
                                            Width="20"
                                            Height="20"
                                            Foreground="{DynamicResource Foreground}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Start on boot Toggle -->
                        <Border Classes="SettingsItem">
                            <Grid ColumnDefinitions="Auto,*,Auto">

                                <materialIcons:MaterialIcon
                                    Kind="RocketLaunchOutline"
                                    Width="28"
                                    Height="28"
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource Foreground}" />

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="Launch at Startup"
                                               FontFamily="{DynamicResource AppFontFamily}" FontWeight="Bold"
                                               FontSize="16"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Foreground}" />

                                    <TextBlock Text="Whether the app should automatically launch when you log in"
                                               FontFamily="{DynamicResource AppFontFamily}"
                                               FontSize="13"
                                               Margin="0,4,0,0"
                                               Foreground="{DynamicResource Foreground}"
                                               Opacity="0.7"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <ToggleSwitch Grid.Column="2"
                                              IsChecked="{Binding IsStartOnBootEnabled}"
                                              VerticalAlignment="Center"
                                              FontFamily="{DynamicResource AppFontFamily}"
                                              Foreground="{DynamicResource Foreground}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>