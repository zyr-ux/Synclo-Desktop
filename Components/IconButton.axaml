<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">
    <Design.PreviewWith>
        <Border Padding="20" Background="DimGray">
            <!-- Add Controls for Previewer Here -->
            <StackPanel Orientation="Vertical" Spacing="20">
                <Button Classes="icon-button"
                        HorizontalAlignment="Right"
                        IsEnabled="True">
                    <materialIcons:MaterialIcon
                        Kind="Refresh"
                        Width="30"
                        Height="30"/>
                </Button>
                
            </StackPanel>

        </Border>
    </Design.PreviewWith>

    <Style Selector="Button.icon-button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="CornerRadius" Value="40"/>
        
    </Style>
    <Style Selector="Button.icon-button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#1A000000" />
    </Style>

    <Style Selector="Button.icon-button:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="#33000000" />
    </Style>

    <Style Selector="Button.icon-button:disabled /template/ ContentPresenter">
        <Setter Property="Opacity" Value="0.4" />
        <Setter Property="Background" Value="Transparent"/>
    </Style>
</Styles>