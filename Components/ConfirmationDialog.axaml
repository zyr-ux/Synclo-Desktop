<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Synclo.Components.ConfirmationDialog"
        Title="Confirm Action" 
        Width="350" Height="220"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        TransparencyLevelHint="None"
        SystemDecorations="None"
        CanResize="False"
        ShowInTaskbar="False">

    <Border Background="{DynamicResource SidebarBackground}"
            CornerRadius="20" 
            BorderBrush="{DynamicResource Accent}" 
            BorderThickness="0"
            Padding="25">
        <Grid RowDefinitions="Auto, *, Auto">
            
            <TextBlock Grid.Row="0" 
                       Name="TitleText"
                       Text="Confirm Action" 
                       FontSize="28" 
                       FontFamily="{DynamicResource Inconsolata-Bold}" 
                       Foreground="{DynamicResource ForegroundL}"/>

            <TextBlock Grid.Row="1" 
                       Name="MessageText"
                       Text="Are you sure you want to proceed with this action?" 
                       Foreground="{DynamicResource ForegroundL}" 
                       TextWrapping="Wrap"
                       TextAlignment="Left"
                       FontSize="16"
                       FontFamily="{DynamicResource Inconsolata-Medium}"
                       VerticalAlignment="Center" 
                       Margin="0,15"/>

            <StackPanel Grid.Row="2" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right" 
                        Spacing="12">
                
                <Button Name="NoButton" 
                        Content="No" 
                        Click="OnNoClick"
                        Width="100" 
                        Height="40"
                        Classes="custom-button"/>

                <Button Name="YesButton" 
                        Content="Yes" 
                        Click="OnYesClick"
                        Width="100" 
                        Height="40"
                        Classes="custom-button"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>