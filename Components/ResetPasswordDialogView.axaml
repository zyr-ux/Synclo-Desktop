<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:components="clr-namespace:Synclo.Components"
        x:Class="Synclo.Components.ResetPasswordDialogView"
        x:DataType="components:ResetPasswordDialogViewModel"
        Width="400"
        SizeToContent="Height"
        MaxHeight="450"
        Background="Transparent"
        TransparencyLevelHint="None"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        ShowInTaskbar="False"
        CanResize="False">

    <Border
        Margin="25"
        Background="{DynamicResource SidebarBackground}"
        BoxShadow="0 10 30 0 #40000000, 0 2 10 0 #20000000"
        Padding="25"
        CornerRadius="20">
        <Grid RowDefinitions="Auto,*,Auto">

            <TextBlock Grid.Row="0"
                       Text="Reset Password"
                       FontSize="28"
                       Foreground="{DynamicResource Yellow}"
                       FontFamily="{DynamicResource Inconsolata-Bold}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,35"/>

            <StackPanel Grid.Row="1"
                                Spacing="25"
                                VerticalAlignment="Center">

                        <StackPanel Spacing="3">
                            
                            <TextBlock Text="Current Password"
                                       Foreground="{DynamicResource Accent}"
                                       FontFamily="{DynamicResource Inconsolata-Medium}" />

                            <TextBox PasswordChar="*"
                                     Text="{Binding CurrentPassword}"
                                     Background="Transparent"
                                     BorderThickness="0 0 0 1"
                                     Padding="3"
                                     CornerRadius="0"
                                     Classes="revealPasswordButton"
                                     IsEnabled="{Binding !IsBusy}" />
                        </StackPanel>

                        <StackPanel Spacing="3">
                            <TextBlock Text="New Password"
                                       Foreground="{DynamicResource Accent}"
                                       FontFamily="{DynamicResource Inconsolata-Medium}" />

                            <TextBox PasswordChar="*"
                                     Text="{Binding NewPassword}"
                                     Background="Transparent"
                                     BorderThickness="0 0 0 1"
                                     Padding="3"
                                     CornerRadius="0"
                                     Classes="revealPasswordButton"
                                     IsEnabled="{Binding !IsBusy}" />
                        </StackPanel>

                        <StackPanel Spacing="3">
                            <TextBlock Text="Confirm Password"
                                       Foreground="{DynamicResource Accent}"
                                       FontFamily="{DynamicResource Inconsolata-Medium}" />

                            <TextBox PasswordChar="*"
                                     Text="{Binding ConfirmPassword}"
                                     Background="Transparent"
                                     BorderThickness="0 0 0 1"
                                     Padding="3"
                                     CornerRadius="0"
                                     Classes="revealPasswordButton"
                                     IsEnabled="{Binding !IsBusy}" />
                        </StackPanel>
                
                    </StackPanel>

            <StackPanel Grid.Row="2"
                        Spacing="15"
                        Margin="0,20,0,0">

                <Grid>
                    <TextBlock Text="{Binding StatusMessage}"
                               HorizontalAlignment="Center"
                               IsVisible="{Binding !!StatusMessage}"
                               Foreground="{DynamicResource Accent}"/>

                    <TextBlock Text="{Binding ErrorMessage}"
                               HorizontalAlignment="Center"
                               IsVisible="{Binding !!ErrorMessage}"
                               Foreground="#FF5555"/>
                </Grid>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="10">

                    <Button Classes="icon-button"
                            Command="{Binding CancelCommand}"
                            IsEnabled="{Binding !IsBusy}">
                        <materialIcons:MaterialIcon 
                            Kind="Close"
                            Width="24"
                            Height="24"/>
                    </Button>

                    <Button Classes="icon-button"
                            Command="{Binding SubmitCommand}"
                            IsEnabled="{Binding !IsBusy}">
                        <materialIcons:MaterialIcon 
                            Kind="ArrowRight"
                            Width="24"
                            Height="24"/>
                    </Button>
                </StackPanel>

            </StackPanel>
        </Grid>
    </Border>
</Window>
